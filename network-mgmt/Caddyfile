{
	# General options
	http_port 80
	https_port 443

	# logging
	log {
		output file /var/log/caddy/reverse_proxy.log
		format json
	}
}

# stolen from reddit
(logging) {
	log {
		output file /var/log/caddy/{args[0]}.log
		format json
	}
}

adguard.home {
	tls internal
	import logging adguard
	reverse_proxy adguard:3000
}

vault.home {
	tls internal
	import logging vault
	reverse_proxy vaultwarden:80
}

dash.home {
	tls internal
	import logging homepage
	reverse_proxy homepage:3000
}
